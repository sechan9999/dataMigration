-- =====================================================
-- Data Quality Metrics
-- =====================================================

Data Completeness =
VAR TotalResults = [Total Lab Results]
VAR CompleteResults =
    CALCULATE(
        COUNTROWS(FactLabResult),
        NOT(ISBLANK(FactLabResult[ResultValueNumeric])),
        NOT(ISBLANK(FactLabResult[ResultDateKey])),
        NOT(ISBLANK(FactLabResult[PatientKey]))
    )
RETURN
DIVIDE(CompleteResults, TotalResults, 0)

Missing Result Values =
CALCULATE(
    COUNTROWS(FactLabResult),
    ISBLANK(FactLabResult[ResultValueNumeric])
)

-- =====================================================
-- Lab Performance Metrics
-- =====================================================

Average Daily Volume =
AVERAGEX(
    VALUES(DimDate[Date]),
    [Total Lab Results]
)

Peak Daily Volume =
MAXX(
    VALUES(DimDate[Date]),
    [Total Lab Results]
)

-- =====================================================
-- Custom Formatting Measures
-- =====================================================

TAT Display =
FORMAT([Average Turnaround Time (Hours)], "0.0") & " hrs"

Volume Trend Indicator =
VAR Growth = [Lab Results MoM Growth]
RETURN
SWITCH(
    TRUE(),
    Growth > 0.1, "↑ Growing",
    Growth < -0.1, "↓ Declining",
    "→ Stable"
)

Quality Score =
VAR ValidationRate = [Validation Pass Rate]
VAR CriticalRate = 1 - [Critical Value Rate]
VAR AnomalyRate = 1 - [Anomaly Rate]
RETURN
(ValidationRate * 0.4) + (CriticalRate * 0.3) + (AnomalyRate * 0.3)

Quality Score Display =
FORMAT([Quality Score], "0.0%")

-- =====================================================
-- Conditional Formatting Helpers
-- =====================================================

Critical Value Color =
IF(
    [Critical Value Rate] > 0.05,
    "Red",
    IF([Critical Value Rate] > 0.02, "Yellow", "Green")
)

TAT Performance Color =
IF(
    [Turnaround Time SLA Met] < 0.80,
    "Red",
    IF([Turnaround Time SLA Met] < 0.90, "Yellow", "Green")
)
